# ==============================================================================
# RAJLABS-CA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=0.0.0.0
BASE_URL=https://backend.rajlabs.in/cert-signer

# Security & Access Control
API_KEY=rajlabs_super_secret_api_key_change_me_in_production
ADMIN_PASSWORD=change_this_admin_password_in_production

# CA Configuration
CA_ORGANIZATION=Rajlabs
CA_COUNTRY=IN
CA_STATE=Karnataka
CA_CITY=Bengaluru

# ACME Settings
ACME_ALLOW_PRIVATE_NETWORKS=true
ACME_DEFAULT_INTERMEDIATE=int-server
ACME_CERT_VALIDITY_DAYS=90

# CRL & AIA Fallback Distribution Points
CRL_DAYS_VALID=7
AUTO_REGENERATE_CRL_HOURS=24
CRL_FALLBACK_URLS=http://certs.rajlabs.in,http://crl.rajlabs.in,http://pki.rajlabs.in
OCSP_FALLBACK_URLS=http://certs.rajlabs.in/ocsp,http://ocsp.rajlabs.in,http://pki.rajlabs.in/ocsp

